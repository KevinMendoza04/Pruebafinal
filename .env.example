# HelpFlow — Environment variables (placeholders only, no real secrets)

# Database
DB_USERNAME=helpflow
DB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-to-a-32-byte-secret-minimum
JWT_EXPIRATION_MINUTES=60

# Admin bootstrap
ADMIN_DOCUMENT=ADMIN-000
ADMIN_EMAIL=admin@helpflow.com
ADMIN_PASSWORD=change-me

# Corporate email domain
CORPORATE_EMAIL_DOMAIN=helpflow.com

# Escalation
ESCALATION_SCAN_INTERVAL=60
ESCALATION_THRESHOLD_PERCENT=80

# Demo seed
DEMO_SEED_PASSWORD=demo-pass

# Spring profile
SPRING_PROFILES_ACTIVE=demo
