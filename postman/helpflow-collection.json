{
  "info": {
    "name": "HelpFlow API",
    "_postman_id": "helpflow-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "dispatchUrl", "value": "http://localhost:8081"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"document\":\"DOC-001\",\"fullName\":\"Ana Lopez\",\"email\":\"ana@helpflow.com\",\"site\":\"BOGOTA\",\"department\":\"IT\",\"password\":\"pass123\"}"}
          }
        },
        {
          "name": "Login",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();","if(json.accessToken) pm.collectionVariables.set('token', json.accessToken);"]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\":\"ana@helpflow.com\",\"password\":\"pass123\"}"}
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tickets",
            "header": [{"key": "Content-Type", "value": "application/json"},{"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"title\":\"Server down\",\"description\":\"Production server not responding\",\"category\":\"RED\",\"priority\":\"ALTA\",\"site\":\"BOGOTA\",\"affectedAsset\":\"SRV-001\"}"}
          }
        },
        {
          "name": "List Tickets",
          "request": {"method": "GET", "url": "{{baseUrl}}/tickets?page=0&size=20", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}
        },
        {
          "name": "Get Ticket",
          "request": {"method": "GET", "url": "{{baseUrl}}/tickets/{{ticketId}}", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}
        },
        {
          "name": "Cancel Ticket (DELETE)",
          "request": {"method": "DELETE", "url": "{{baseUrl}}/tickets/{{ticketId}}?observation=Cancelado", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}
        },
        {
          "name": "Transition to EN_PROGRESO",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tickets/{{ticketId}}/transitions",
            "header": [{"key": "Content-Type", "value": "application/json"},{"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"targetStatus\":\"EN_PROGRESO\",\"observation\":\"Trabajando\"}"}
          }
        },
        {
          "name": "Transition to RESUELTO",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tickets/{{ticketId}}/transitions",
            "header": [{"key": "Content-Type", "value": "application/json"},{"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"targetStatus\":\"RESUELTO\",\"observation\":\"Resuelto\"}"}
          }
        },
        {
          "name": "Get History",
          "request": {"method": "GET", "url": "{{baseUrl}}/tickets/{{ticketId}}/history", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {"name": "Get SLA Policies", "request": {"method": "GET", "url": "{{baseUrl}}/admin/sla-policies", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}},
        {"name": "Run Escalation", "request": {"method": "POST", "url": "{{baseUrl}}/admin/escalation/run", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}}
      ]
    },
    {
      "name": "Dispatch Service",
      "item": [
        {
          "name": "Dispatch Suggest",
          "request": {
            "method": "POST",
            "url": "{{dispatchUrl}}/technician-dispatch",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"ticketId\":125,\"categoria\":\"RED\",\"prioridad\":\"ALTA\"}"}
          }
        }
      ]
    },
    {
      "name": "Actuator",
      "item": [
        {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/actuator/health"}},
        {"name": "Prometheus", "request": {"method": "GET", "url": "{{baseUrl}}/actuator/prometheus", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]}}
      ]
    }
  ]
}
